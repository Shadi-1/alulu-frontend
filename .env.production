# Production API base URL — points the React build at the Render-hosted FastAPI.
# Replace <service-name> with the actual Render service name once it is created
# (the URL Render gives you, e.g. https://carbon-platform-api.onrender.com).
# Vite reads this at `npm run build` time and bakes it into the bundle.
VITE_API_BASE=https://carbon-platform-api.onrender.com
